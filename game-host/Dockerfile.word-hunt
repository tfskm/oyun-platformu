# Kelime Avı — KENDİ Coolify uygulaması. Build context: REPO KÖKÜ.
# Sadece bu oyunu derler, sadece bu oyunu servis eder.

FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY scripts/ensure-esbuild.cjs scripts/ensure-esbuild.cjs
RUN npm ci --include=dev --no-audit --no-fund
COPY games/word-hunt games/word-hunt
RUN npx vite build --config games/word-hunt/vite.config.ts

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000 \
    GAME_ID=word-hunt
COPY game-host/server.cjs ./server.cjs
COPY --from=build /app/dist/games/word-hunt ./dist/games/word-hunt
RUN addgroup -S game && adduser -S game -G game && chown -R game:game /app
USER game
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -q -O- http://127.0.0.1:3000/healthz >/dev/null || exit 1
CMD ["node", "server.cjs"]
